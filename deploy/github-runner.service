# systemd-юнит, который ставит ./svc.sh из runner'а.
# Оставлен здесь как эталон, если svc.sh недоступен или нужна правка:
#   cp deploy/github-runner.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now github-runner
[Unit]
Description=GitHub Actions Runner (self-hosted GPU)
After=network.target

[Service]
Type=simple
User=ghrunner
WorkingDirectory=/opt/actions-runner
ExecStart=/opt/actions-runner/run.sh
Restart=always
RestartSec=5
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

# Минимально необходимое: runner не должен уметь больше, чем нужно job'ам
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
